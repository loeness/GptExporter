{
  "name": "gpt-exporter",
  "version": "1.4.1",
  "private": true,
  "description": "An independent local-first ChatGPT conversation exporter for Chromium",
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:advanced": "node tests/advanced-browser.cjs",
    "test:selection": "node tests/selection-browser.cjs",
    "test:platforms": "node tests/platforms-browser.cjs",
    "build:vendor": "node scripts/build-vendor.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "html2canvas": "1.4.1",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mathjax-full": "3.2.2",
    "mermaid": "12.2.0",
    "pdfmake": "0.3.13"
  }
}
